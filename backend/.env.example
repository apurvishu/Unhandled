# ===== Application =====
APP_NAME=SIH26006 Freight Platform
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# ===== Database =====
POSTGRES_USER=sih26006
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=sih26006
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
ASYNC_DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ===== JWT Authentication =====
SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== CORS =====
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# ===== External API Keys =====
AIS_API_KEY=
AIS_API_URL=
WEATHER_API_KEY=
WEATHER_API_URL=
FREIGHT_API_KEY=
FREIGHT_API_URL=

# ===== Celery =====
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===== ML Models =====
ML_MODELS_DIR=data/models
FREIGHT_MODEL_VERSION=v1.0
CONGESTION_MODEL_VERSION=v1.0

# ===== Logging =====
LOG_LEVEL=INFO
